generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())

  email     String   @unique
  username  String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  matchesAsWhite Match[] @relation("WhitePlayer")
  matchesAsBlack Match[] @relation("BlackPlayer")
}

model Match {
  id        String    @id @default(cuid())

  status    String    @default("active") // active | completed | draw | abandoned
  startTime DateTime  @default(now())
  endTime   DateTime?

  winner    String?   // "white" | "black" | null

  // Foreign Keys
  whitePlayerId String
  blackPlayerId String

  // Relations
  whitePlayer User @relation("WhitePlayer", fields: [whitePlayerId], references: [id])
  blackPlayer User @relation("BlackPlayer", fields: [blackPlayerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whitePlayerId])
  @@index([blackPlayerId])
}
